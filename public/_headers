# Versiyonlu statik asset'ler (?v= cache-busting ile çağrılır) → 1 yıl immutable.
# Güvenlik başlıkları tüm route'lara ekleniyor (Cloudflare Pages, _headers'ı Function yanıtlarıyla da birleştirir).

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

/market/*
  Content-Security-Policy: default-src 'self'; script-src 'self' accounts.google.com static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' accounts.google.com; img-src 'self' data: blob: *.googleusercontent.com; connect-src 'self' accounts.google.com; frame-src accounts.google.com; object-src 'none'; base-uri 'self'; form-action 'self' accounts.google.com; frame-ancestors 'none'

/marketplace.css
  Cache-Control: public, max-age=31536000, immutable

/marketplace-enhance.js
  Cache-Control: public, max-age=31536000, immutable

/theme.css
  Cache-Control: public, max-age=31536000, immutable

/auth.js
  Cache-Control: public, max-age=31536000, immutable

/market-account.js
  Cache-Control: public, max-age=31536000, immutable

/marketplace-cart.js
  Cache-Control: public, max-age=31536000, immutable

/pimg/*.jpg
  Cache-Control: public, max-age=31536000, immutable
