---
import { defaultLang, type Lang } from '../i18n/ui';
import { getHomeContent } from '../i18n/home';
import SmoothScroll from './islands/SmoothScroll.tsx';
import CursorSpotlight from './islands/CursorSpotlight.tsx';
import ScrollReveal from './islands/ScrollReveal.tsx';
import Hero from './islands/Hero.tsx';
import HorizontalFeatures from './islands/HorizontalFeatures.tsx';
import SEODemo from './islands/SEODemo.tsx';
import CountUp from './islands/CountUp.tsx';
import MarqueeRows from './sections/MarqueeRows.astro';
import BentoGrid from './sections/BentoGrid.astro';

interface Props { lang?: Lang }
const { lang = defaultLang } = Astro.props;
const c = getHomeContent(lang);

const features = c.features.items.map((item, idx) => ({
  n: String(idx + 1).padStart(2, '0'),
  ...item,
  iphone: `/screenshots/iphone/slot-${String(idx + 1).padStart(2, '0')}.png`,
  ipad: `/screenshots/ipad/slot-${String(idx + 1).padStart(2, '0')}.png`,
}));

const statsTitleHtml = c.stats.title.replace(/\n/g, '<br/>');
---

<SmoothScroll client:load />
<CursorSpotlight client:idle />
<ScrollReveal client:load />

<Hero client:load content={c.hero} />

<MarqueeRows />

<!-- Pain → Solution -->
<section class="pain">
  <div class="container">
    <div class="pain-head" data-reveal>
      <span class="kicker">{c.pain.kicker}</span>
      <h2 class="section-title">{c.pain.title}</h2>
      <p class="section-sub">{c.pain.sub}</p>
    </div>
    <div class="pain-grid">
      {c.pain.cards.map((card, i) => (
        <div class="pain-card" data-reveal style={`transition-delay: ${i * 100}ms`}>
          <div class="pain-bad">{card.bad}</div>
          <div class="pain-arrow">→</div>
          <div class="pain-good">
            <strong>{card.goodTitle}</strong>
            <p>{card.goodDesc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<div id="features">
  <HorizontalFeatures
    client:visible
    features={features}
    head={{ kicker: c.features.sectionKicker, title: c.features.sectionTitle, sub: c.features.sectionSub }}
    seeInAction={c.features.seeInAction}
  />
</div>

<BentoGrid content={c.bento} />

<section class="seodemo-wrap">
  <SEODemo client:visible content={c.seoDemo} />
</section>

<!-- Stats -->
<section class="stats">
  <div class="container">
    <div data-reveal>
      <span class="kicker">{c.stats.kicker}</span>
      <h2 class="section-title" set:html={statsTitleHtml}></h2>
    </div>
    <div class="stat-grid">
      <div class="stat-card" data-reveal>
        <div class="stat-num"><CountUp client:visible to={46} suffix="+" /></div>
        <div class="stat-label">{c.stats.labels.marketplaces}</div>
      </div>
      <div class="stat-card" data-reveal style="transition-delay: 80ms">
        <div class="stat-num"><CountUp client:visible to={9} /></div>
        <div class="stat-label">{c.stats.labels.seoFields}</div>
      </div>
      <div class="stat-card" data-reveal style="transition-delay: 160ms">
        <div class="stat-num"><CountUp client:visible to={12} /></div>
        <div class="stat-label">{c.stats.labels.languages}</div>
      </div>
      <div class="stat-card" data-reveal style="transition-delay: 240ms">
        <div class="stat-num">0</div>
        <div class="stat-label">{c.stats.labels.zero}</div>
      </div>
    </div>
    <div class="compliance-row" data-reveal>
      <span class="pill"><span class="pill-dot"/> {c.stats.pills.gdpr}</span>
      <span class="pill"><span class="pill-dot"/> {c.stats.pills.kvkk}</span>
      <span class="pill"><span class="pill-dot"/> {c.stats.pills.ccpa}</span>
      <span class="pill"><span class="pill-dot"/> {c.stats.pills.wcag}</span>
      <span class="pill"><span class="pill-dot"/> {c.stats.pills.noTracking}</span>
    </div>
  </div>
</section>

<!-- Pricing -->
<section id="pricing" class="pricing">
  <div class="container">
    <div class="pricing-head" data-reveal>
      <span class="kicker">{c.pricing.kicker}</span>
      <h2 class="section-title">{c.pricing.title}</h2>
      <p class="section-sub">{c.pricing.sub}</p>
    </div>
    <div class="pricing-grid">
      {c.pricing.plans.map((plan, idx) => {
        const isFeatured = plan.featured === true;
        const [price, per] = plan.pricePer.split('/');
        return (
          <div class={`plan ${isFeatured ? 'plan-featured' : ''}`} data-reveal style={`transition-delay: ${idx * 80}ms`}>
            {isFeatured && <span class="plan-badge">{c.pricing.badge}</span>}
            <div class="plan-head">
              <span class="plan-name">{plan.name}</span>
              <div class="plan-price">{price}<span>/{per}</span></div>
              {plan.trial && <div class="plan-trial">{plan.trial}</div>}
            </div>
            <ul class="plan-features">
              {plan.features.map((f) => {
                const isMuted = f.startsWith('—');
                const html = f.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
                return (
                  <li>
                    {isMuted ? <span class="muted" set:html={html}></span> : <><span class="ok">✓</span><span set:html={html}></span></>}
                  </li>
                );
              })}
            </ul>
            <a href="#download" class={`plan-cta ${!isFeatured ? 'plan-cta-secondary' : ''}`}>{plan.cta}</a>
          </div>
        );
      })}
    </div>
    <p class="pricing-note">{c.pricing.note}</p>
  </div>
</section>

<!-- FAQ -->
<section id="faq" class="faq">
  <div class="container">
    <div class="faq-head" data-reveal>
      <span class="kicker">{c.faq.kicker}</span>
      <h2 class="section-title">{c.faq.title}</h2>
    </div>
    <div class="faq-list">
      {c.faq.items.map((item) => (
        <details data-reveal>
          <summary>{item.q}</summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<!-- Final CTA -->
<section id="download" class="final-cta">
  <div class="container">
    <div data-reveal>
      <img src="/icon-256.png" alt="photoZseo app icon" width="128" height="128" class="final-cta-icon"/>
      <h2>{c.finalCta.h2}</h2>
      <p>{c.finalCta.p}</p>
      <div class="cta-row cta-row-center">
        <a href="#download" class="btn-app btn-app-large">
          <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor" aria-hidden="true">
            <path d="M16.498 12.43c.02-2.176 1.776-3.221 1.856-3.27-1.013-1.481-2.585-1.683-3.139-1.704-1.319-.134-2.594.78-3.265.78-.685 0-1.713-.766-2.823-.744-1.43.022-2.76.842-3.491 2.131-1.493 2.59-.38 6.415 1.07 8.519.71 1.029 1.541 2.18 2.633 2.14 1.073-.043 1.474-.681 2.766-.681s1.66.681 2.776.659c1.149-.022 1.873-1.034 2.566-2.072.812-1.179 1.143-2.339 1.157-2.398-.026-.011-2.214-.85-2.106-3.36zM14.396 5.879c.575-.722.967-1.713.86-2.722-.831.035-1.866.578-2.466 1.281-.532.612-1.005 1.622-.886 2.588.942.075 1.906-.473 2.492-1.147z"/>
          </svg>
          <span class="btn-app-text">
            <span class="btn-app-small">{c.hero.btnAppSmall}</span>
            <span class="btn-app-big">{c.hero.btnAppBig}</span>
          </span>
        </a>
      </div>
      <p class="final-note">{c.finalCta.note} <a href="mailto:hello@photozseo.com?subject=Notify%20me%20at%20launch">{c.finalCta.notify}</a>.</p>
    </div>
  </div>
</section>

<!-- JSON-LD -->
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": "photoZseo",
      "operatingSystem": "iOS 17, iPadOS, macOS",
      "applicationCategory": "BusinessApplication",
      "description": "Turn one product photo into 46 marketplace-ready listings. AI auto-fills SEO, exports to Amazon, Shopify, Etsy, Trendyol and more.",
      "url": "https://photozseo.com",
      "offers": [
        { "@type": "Offer", "price": "2.99", "priceCurrency": "USD", "category": "Pro Weekly" },
        { "@type": "Offer", "price": "6.99", "priceCurrency": "USD", "category": "Pro Monthly" },
        { "@type": "Offer", "price": "39.99", "priceCurrency": "USD", "category": "Pro Annual" }
      ],
      "featureList": ["46 marketplace export presets","AI SEO auto-fill","Pro camera studio","Background removal","B2B quote builder","Stories","EXIF editor","iPhone iPad Mac universal","iCloud Drive sync","On-device AI"],
      "inLanguage": ["en","tr","de","es","fr","pt","ja","ko","zh","ar","hi","fa"]
    },
    {
      "@type": "FAQPage",
      "mainEntity": c.faq.items.map((it) => ({
        "@type": "Question", "name": it.q,
        "acceptedAnswer": { "@type": "Answer", "text": it.a }
      }))
    }
  ]
})} />

<style>
  /* ====== Shared section primitives ====== */
  .container { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
  .kicker {
    display: inline-block; font-size: 12px; font-weight: 700; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--accent);
    padding: 7px 12px; border-radius: 999px;
    background: rgba(79,209,197,0.10); border: 1px solid rgba(79,209,197,0.28);
  }
  .section-title {
    font-size: clamp(30px, 4.6vw, 52px);
    letter-spacing: -0.025em; line-height: 1.05; margin: 14px 0 14px;
    font-weight: 600;
  }
  .section-sub { color: var(--text-muted); font-size: clamp(16px, 2vw, 19px); max-width: 640px; margin-bottom: 36px; line-height: 1.55; }

  /* ====== Reveal animation ====== */
  [data-reveal] {
    opacity: 0; transform: translateY(28px);
    transition: opacity .8s cubic-bezier(.16,1,.3,1), transform .8s cubic-bezier(.16,1,.3,1);
    will-change: opacity, transform;
  }
  [data-reveal].is-revealed { opacity: 1; transform: translateY(0); }
  @media (prefers-reduced-motion: reduce) {
    [data-reveal] { opacity: 1 !important; transform: none !important; }
  }

  /* ====== CTA primitives ====== */
  .btn-app {
    display: inline-flex; align-items: center; gap: 12px;
    padding: 14px 22px; border-radius: 14px;
    background: #000; color: #fff; border: 1px solid #2a2a2a;
    transition: transform .15s ease, box-shadow .15s ease, background .15s ease;
    box-shadow: 0 4px 20px rgba(0,0,0,0.4);
  }
  .btn-app:hover { transform: translateY(-2px); background: #1a1a1a; color: #fff; box-shadow: 0 8px 28px rgba(79,209,197,0.25); }
  .btn-app-text { display: flex; flex-direction: column; line-height: 1.05; text-align: left; }
  .btn-app-small { font-size: 11px; opacity: 0.85; }
  .btn-app-big { font-size: 20px; font-weight: 600; letter-spacing: -0.01em; }
  .btn-app-large { padding: 18px 28px; }
  .btn-app-large .btn-app-big { font-size: 24px; }
  .cta-row { display: flex; align-items: center; gap: 20px; flex-wrap: wrap; }
  .cta-row-center { justify-content: center; margin: 32px 0 16px; }

  /* ====== Pain → Solution ====== */
  .pain { padding: 140px 0 100px; }
  .pain-head { text-align: center; max-width: 720px; margin: 0 auto 48px; }
  .pain-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .pain-card {
    background: linear-gradient(160deg, rgba(255,255,255,0.04), rgba(255,255,255,0.01));
    border: 1px solid rgba(255,255,255,0.08); border-radius: 22px;
    padding: 26px; display: flex; flex-direction: column; gap: 14px;
    backdrop-filter: blur(20px);
    transition: transform .25s ease, border-color .25s ease;
  }
  .pain-card:hover { transform: translateY(-6px); border-color: rgba(255,255,255,0.18); }
  .pain-bad {
    color: var(--text-dim); font-style: italic; font-size: 15px;
    padding: 14px 16px; background: rgba(0,0,0,0.20);
    border-left: 3px solid rgba(255,255,255,0.20); border-radius: 8px;
  }
  .pain-arrow { color: var(--accent); font-size: 22px; font-weight: 700; }
  .pain-good strong { color: var(--text); font-size: 18px; display: block; margin-bottom: 6px; }
  .pain-good p { color: var(--text-muted); font-size: 14px; }

  /* ====== SEO Demo wrapper ====== */
  .seodemo-wrap { padding: 100px 0 120px; position: relative; }
  .seodemo-wrap::before {
    content: ''; position: absolute; inset: 0; pointer-events: none; z-index: -1;
    background: radial-gradient(ellipse 800px 500px at 50% 50%, rgba(108,140,255,0.12), transparent 70%);
  }

  /* ====== Stats ====== */
  .stats { padding: 140px 0; text-align: center; }
  .stat-grid {
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px;
    margin: 40px 0 36px;
  }
  .stat-card {
    padding: 36px 18px; border-radius: 22px;
    background: linear-gradient(160deg, rgba(255,255,255,0.04), rgba(255,255,255,0.01));
    border: 1px solid rgba(255,255,255,0.08);
    backdrop-filter: blur(20px);
  }
  .stat-num {
    font-size: clamp(40px, 6vw, 64px); font-weight: 700;
    letter-spacing: -0.03em; line-height: 1; margin-bottom: 8px;
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .stat-label { color: var(--text-muted); font-size: 14px; }
  .compliance-row {
    display: flex; justify-content: center; gap: 12px; flex-wrap: wrap;
  }
  .pill {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 9px 16px; border-radius: 999px;
    background: rgba(16,185,129,0.08); border: 1px solid rgba(16,185,129,0.32);
    color: var(--text); font-size: 13px; font-weight: 500;
  }
  .pill-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--success); box-shadow: 0 0 10px var(--success); }

  /* ====== Pricing ====== */
  .pricing { padding: 120px 0; }
  .pricing-head { text-align: center; max-width: 720px; margin: 0 auto 48px; }
  .pricing-grid {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px;
    align-items: stretch;
  }
  .plan {
    background: linear-gradient(160deg, rgba(255,255,255,0.04), rgba(255,255,255,0.01));
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 24px; padding: 32px 28px;
    display: flex; flex-direction: column;
    position: relative; backdrop-filter: blur(20px);
    transition: transform .25s ease, border-color .25s ease;
  }
  .plan:hover { transform: translateY(-4px); border-color: rgba(255,255,255,0.18); }
  .plan-featured {
    background: linear-gradient(160deg, rgba(79,209,197,0.10), rgba(108,140,255,0.10));
    border: 1px solid rgba(79,209,197,0.45);
    transform: scale(1.02);
    box-shadow: 0 30px 60px -20px rgba(79,209,197,0.20);
  }
  .plan-featured:hover { transform: scale(1.02) translateY(-4px); }
  .plan-badge {
    position: absolute; top: -12px; right: 20px;
    background: var(--gold); color: #0B0E1A;
    padding: 6px 12px; border-radius: 999px;
    font-size: 11px; font-weight: 700; letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .plan-name { font-size: 14px; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.12em; }
  .plan-price { font-size: 44px; font-weight: 700; letter-spacing: -0.02em; margin-top: 10px; line-height: 1; }
  .plan-price span { font-size: 16px; color: var(--text-muted); font-weight: 500; margin-left: 4px; }
  .plan-trial { margin-top: 8px; font-size: 13px; color: var(--accent); }
  .plan-features { list-style: none; margin: 22px 0 28px; display: flex; flex-direction: column; gap: 10px; flex-grow: 1; padding: 0; }
  .plan-features li { color: var(--text-muted); font-size: 14px; display: flex; gap: 8px; }
  .plan-features .ok { color: var(--accent); font-weight: 700; }
  .plan-features .muted { color: var(--text-dim); font-style: italic; }
  .plan-features strong { color: var(--text); }
  .plan-cta {
    display: block; text-align: center; padding: 14px 18px;
    border-radius: 12px; font-weight: 600; font-size: 15px;
    background: var(--text); color: #0B0E1A;
    transition: transform .15s ease, background .15s ease;
  }
  .plan-cta:hover { transform: translateY(-1px); background: var(--accent); color: #0B0E1A; }
  .plan-cta-secondary {
    background: transparent; color: var(--text);
    border: 1px solid rgba(255,255,255,0.16);
  }
  .plan-cta-secondary:hover { background: rgba(255,255,255,0.06); color: var(--text); }
  .pricing-note {
    margin: 28px auto 0; max-width: 720px; text-align: center;
    font-size: 12px; color: var(--text-dim); line-height: 1.6;
  }

  /* ====== FAQ ====== */
  .faq { padding: 120px 0; }
  .faq-head { text-align: center; max-width: 720px; margin: 0 auto 36px; }
  .faq-list { max-width: 800px; margin: 0 auto; display: flex; flex-direction: column; gap: 10px; }
  details {
    background: linear-gradient(160deg, rgba(255,255,255,0.04), rgba(255,255,255,0.01));
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 16px; padding: 20px 24px;
    transition: border-color .15s ease;
    backdrop-filter: blur(12px);
  }
  details[open] { border-color: rgba(255,255,255,0.18); }
  summary {
    cursor: pointer; list-style: none;
    font-weight: 600; font-size: 16px; color: var(--text);
    display: flex; justify-content: space-between; align-items: center; gap: 12px;
  }
  summary::-webkit-details-marker { display: none; }
  summary::after {
    content: '+'; color: var(--accent); font-size: 24px; line-height: 1; flex-shrink: 0;
    transition: transform .15s ease;
  }
  details[open] summary::after { content: '−'; }
  details p { color: var(--text-muted); font-size: 15px; margin-top: 14px; line-height: 1.6; }

  /* ====== Final CTA ====== */
  .final-cta {
    padding: 120px 24px; text-align: center;
    position: relative; overflow: hidden;
    border-top: 1px solid var(--border);
    margin-top: 80px;
  }
  .final-cta::before {
    content: ''; position: absolute; inset: 0; pointer-events: none; z-index: -1;
    background:
      radial-gradient(ellipse 900px 500px at 50% 0%, rgba(79,209,197,0.22), transparent 70%),
      radial-gradient(ellipse 700px 500px at 50% 100%, rgba(108,140,255,0.26), transparent 70%);
  }
  .final-cta-icon {
    width: 128px; height: 128px; margin: 0 auto 24px;
    display: block; filter: drop-shadow(0 0 40px rgba(79,209,197,0.30));
  }
  .final-cta h2 {
    font-size: clamp(36px, 6vw, 64px);
    letter-spacing: -0.03em; line-height: 1.02;
    margin-bottom: 16px; font-weight: 700;
  }
  .final-cta > .container > div > p { color: var(--text-muted); font-size: 19px; max-width: 580px; margin: 0 auto; }
  .final-note { margin-top: 18px !important; font-size: 14px; color: var(--text-dim); }

  /* ====== Responsive ====== */
  @media (max-width: 960px) {
    .pain-grid { grid-template-columns: 1fr; }
    .stat-grid { grid-template-columns: repeat(2, 1fr); }
    .pricing-grid { grid-template-columns: 1fr; }
    .plan-featured { transform: none; order: -1; }
    .plan-featured:hover { transform: translateY(-4px); }
  }
  @media (max-width: 600px) {
    .pain { padding: 60px 0 30px; }
    .stats { padding: 60px 0; }
    .pricing { padding: 60px 0; }
    .faq { padding: 60px 0; }
    .stat-grid { grid-template-columns: 1fr 1fr; }
    .stat-card { padding: 24px 14px; }
    .final-cta { padding: 80px 24px; }
  }
</style>
