---
import type { Lang } from '../i18n/ui';
import { defaultLang } from '../i18n/ui';
import MarqueeRows from './sections/MarqueeRows.astro';
import { getExt, CHROME_STORE_URL, EXT_VERSION, EXT_UPDATED, WORKS_ON } from '../i18n/extension';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = getExt(lang);
const prefix = lang === defaultLang ? '' : `/${lang}`;
const pageUrl = `https://photozseo.com${prefix}/chrome-extension`;
const notifyHref = `mailto:hello@photozseo.com?subject=${encodeURIComponent('photoZseo Chrome extension')}`;
const updatedText = new Intl.DateTimeFormat(lang, { dateStyle: 'long' }).format(new Date(EXT_UPDATED));

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SoftwareApplication',
      '@id': `${pageUrl}#app`,
      name: 'photoZseo for Chrome',
      alternateName: 'photoZseo Chrome Extension',
      applicationCategory: 'BrowserApplication',
      applicationSubCategory: 'E-commerce product image tool',
      operatingSystem: 'Google Chrome 116+ (Windows, macOS, Linux, ChromeOS)',
      softwareVersion: EXT_VERSION,
      dateModified: EXT_UPDATED,
      description: c.answer,
      url: pageUrl,
      ...(CHROME_STORE_URL ? { downloadUrl: CHROME_STORE_URL, installUrl: CHROME_STORE_URL } : {}),
      image: 'https://photozseo.com/icon-256.png',
      inLanguage: ['en', 'tr', 'de', 'es', 'fr', 'it', 'pt', 'ja', 'ko', 'zh', 'ar', 'hi', 'fa', 'pl', 'ur'],
      featureList: c.feats.map((f) => f.t),
      offers: [
        { '@type': 'Offer', name: 'Free', price: '0', priceCurrency: 'USD' },
        { '@type': 'Offer', name: 'Pro Monthly', price: '7.99', priceCurrency: 'USD', priceSpecification: { '@type': 'UnitPriceSpecification', price: '7.99', priceCurrency: 'USD', billingDuration: 'P1M' } },
        { '@type': 'Offer', name: 'Pro Yearly', price: '59', priceCurrency: 'USD', priceSpecification: { '@type': 'UnitPriceSpecification', price: '59', priceCurrency: 'USD', billingDuration: 'P1Y' } },
        { '@type': 'Offer', name: 'Team Yearly', price: '129', priceCurrency: 'USD', priceSpecification: { '@type': 'UnitPriceSpecification', price: '129', priceCurrency: 'USD', billingDuration: 'P1Y' } },
      ],
      publisher: { '@type': 'Organization', name: 'photoZseo', url: 'https://photozseo.com' },
    },
    {
      '@type': 'FAQPage',
      '@id': `${pageUrl}#faq`,
      mainEntity: c.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'photoZseo', item: `https://photozseo.com${prefix}/` },
        { '@type': 'ListItem', position: 2, name: c.crumb, item: pageUrl },
      ],
    },
  ],
};
---

<article class="ext">
  <!-- HERO -->
  <section class="ext-hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href={`${prefix}/`}>photoZseo</a><span aria-hidden="true">/</span><span>{c.crumb}</span>
        </nav>
        <span class="kicker">{c.kicker}</span>
        <h1>{c.h1a}<span class="grad">{c.h1b}</span></h1>
        <p class="lead">{c.lead}</p>
        <div class="cta-row">
          {CHROME_STORE_URL ? (
            <a class="btn-chrome" href={CHROME_STORE_URL} rel="noopener">
              <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><circle cx="12" cy="12" r="10" fill="#fff"/><circle cx="12" cy="12" r="4" fill="#0B0E1A"/></svg>
              {c.ctaStore}
            </a>
          ) : (
            <>
              <span class="btn-chrome is-soon" aria-disabled="true">
                <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><circle cx="12" cy="12" r="10" fill="currentColor" opacity=".25"/><circle cx="12" cy="12" r="4" fill="currentColor"/></svg>
                {c.ctaSoon}
              </span>
              <a class="btn-ghost" href={notifyHref}>{c.ctaNotify}</a>
            </>
          )}
        </div>
        <p class="cta-note">{c.ctaFree}</p>
        <ul class="trust">
          {c.trust.map((t) => <li><span class="dot" aria-hidden="true"></span>{t}</li>)}
        </ul>
      </div>

      <!-- Browser + side panel illustration -->
      <div class="mock">
        <div class="mock-bar" aria-hidden="true"><i></i><i></i><i></i><span class="mock-url">shop.nordvik.example/products/leather-card-holder</span></div>
        <div class="mock-body">
          <div class="mock-page" aria-hidden="true">
            <img class="mock-photo" src="/pimg/leather-card-holder-tan.jpg" alt="" width="1600" height="1600" />
            <div class="mock-lines"><b></b><b></b><b class="short"></b></div>
            <div class="mock-thumbs">{["50% 50%", "30% 40%", "70% 60%", "50% 80%"].map((pos) => <img src="/pimg/leather-card-holder-tan.jpg" alt="" loading="lazy" style={`object-position:${pos}`} />)}</div>
          </div>
          <div class="mock-panel">
            <img src={`/ext/${c.shot}-1-page.webp`} alt={c.shotAlt[0]} width="400" height="860" fetchpriority="high" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ANSWER BOX (LLM / featured snippet) -->
  <section class="answer">
    <div class="container narrow">
      <div class="answer-card">
        <h2>{c.answerTitle}</h2>
        <p>{c.answer}</p>
        <dl class="facts">
          {c.facts.map(([k, v]) => (<div><dt>{k}</dt><dd>{v}</dd></div>))}
        </dl>
        <p class="updated">{c.updated}: <time datetime={EXT_UPDATED}>{updatedText}</time> · v{EXT_VERSION}</p>
      </div>
    </div>
  </section>

  <!-- HOW -->
  <section class="how" id="how">
    <div class="container">
      <div class="head"><span class="kicker">{c.howKicker}</span><h2 class="section-title">{c.howTitle}</h2></div>
      <ol class="steps">
        {c.steps.map((s, i) => (
          <li class="glass step">
            <figure class="shot"><img src={`/ext/${c.shot}-${['1-page', '2-products', '4-done'][i]}.webp`} alt={c.shotAlt[i]} width="400" height="860" loading="lazy" decoding="async" /></figure>
            <span class="n">{i + 1}</span><h3>{s.t}</h3><p>{s.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- SPEED -->
  <section class="speed" id="speed">
    <div class="container">
      <div class="head"><span class="kicker">{c.speedKicker}</span><h2 class="section-title">{c.speedTitle}</h2><p class="sub">{c.speedSub}</p></div>
      <div class="stats">
        {c.stats.map(([n, l]) => (<div class="stat glass"><div class="stat-n">{n}</div><div class="stat-l">{l}</div></div>))}
      </div>
      <div class="vs">
        <div class="vs-col manual glass">
          <h3>{c.manualTitle}</h3>
          <ol>{c.manualItems.map((m) => <li>{m}</li>)}</ol>
        </div>
        <div class="vs-arrow" aria-hidden="true">→</div>
        <div class="vs-col auto glass">
          <h3>{c.autoTitle}</h3>
          <ol>{c.autoItems.map((m) => <li>{m}</li>)}</ol>
        </div>
      </div>
      <figure class="tree">
        <figcaption>{c.treeTitle}</figcaption>
        <pre>{c.tree.join('\n')}</pre>
      </figure>
      <p class="fine">{c.measured}</p>
    </div>
  </section>

  <!-- FEATURES -->
  <section class="feats" id="features">
    <div class="container">
      <div class="head"><span class="kicker">{c.featKicker}</span><h2 class="section-title">{c.featTitle}</h2></div>
      <div class="feat-grid">
        {c.feats.map((f) => (<div class="glass feat"><h3>{f.t}</h3><p>{f.d}</p></div>))}
      </div>
      <div class="works">
        <h3>{c.worksTitle}</h3>
        <MarqueeRows />
        <p>{c.worksNote}</p>
      </div>
    </div>
  </section>

  <!-- PRIVACY -->
  <section class="priv" id="privacy">
    <div class="container">
      <div class="head"><span class="kicker">{c.privKicker}</span><h2 class="section-title">{c.privTitle}</h2></div>
      <div class="priv-grid">
        {c.privItems.map((p) => (<div class="glass"><span class="pill-dot" aria-hidden="true"></span><h3>{p.t}</h3><p>{p.d}</p></div>))}
      </div>
      <p class="center"><a class="link" href={`${prefix}/privacy#chrome-extension`}>{c.privLink} →</a></p>
    </div>
  </section>

  <!-- PRICING -->
  <section class="pricing" id="pricing">
    <div class="container">
      <div class="head"><span class="kicker">{c.priceKicker}</span><h2 class="section-title">{c.priceTitle}</h2><p class="sub">{c.priceSub}</p></div>
      <div class="plans">
        {c.plans.map((p) => (
          <div class={`plan glass${p.featured ? ' featured' : ''}`}>
            {p.badge && <span class="badge">{p.badge}</span>}
            <div class="plan-name">{p.name}</div>
            <div class="plan-price">{p.price}<span>{p.per}</span></div>
            <div class="plan-note">{p.note}</div>
            <ul>{p.items.map((i) => <li><span class="ok">✓</span>{i}</li>)}</ul>
          </div>
        ))}
      </div>
      <p class="fine">{c.priceNote}</p>
    </div>
  </section>

  <!-- COMPARE -->
  <section class="cmp">
    <div class="container narrow">
      <h2 class="section-title center">{c.cmpTitle}</h2>
      <div class="table-wrap">
        <table>
          <thead><tr>{c.cmpHead.map((h) => <th scope="col">{h}</th>)}</tr></thead>
          <tbody>{c.cmpRows.map(([a, b, d]) => <tr><th scope="row">{a}</th><td>{b}</td><td>{d}</td></tr>)}</tbody>
        </table>
      </div>
      <p class="center"><a class="link" href={`${prefix}/`}>{c.cmpAppLink} →</a></p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="faq" id="faq">
    <div class="container narrow">
      <div class="head"><span class="kicker">{c.faqKicker}</span><h2 class="section-title">{c.faqTitle}</h2></div>
      <div class="faq-list">
        {c.faq.map((f, i) => (
          <details open={i < 2}>
            <summary><h3>{f.q}</h3></summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="final">
    <div class="container narrow center">
      <img src="/icon-256.png" alt="photoZseo icon" width="96" height="96" loading="lazy" />
      <h2>{c.finalTitle}</h2>
      <p>{c.finalText}</p>
      <div class="cta-row center-row">
        {CHROME_STORE_URL
          ? <a class="btn-chrome" href={CHROME_STORE_URL} rel="noopener">{c.ctaStore}</a>
          : <a class="btn-ghost" href={notifyHref}>{c.ctaNotify}</a>}
      </div>
    </div>
  </section>
</article>

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

<style>
  .ext { color: var(--text); }
  .container { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
  .narrow { max-width: 880px; }
  .center { text-align: center; }
  .kicker {
    display: inline-block; font-size: 12px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase;
    color: var(--accent); padding: 7px 12px; border-radius: 999px;
    background: rgba(79,209,197,.10); border: 1px solid rgba(79,209,197,.28);
  }
  .section-title { font-size: clamp(28px, 4.2vw, 46px); letter-spacing: -.025em; line-height: 1.08; margin: 14px 0; font-weight: 600; }
  .head { text-align: center; max-width: 760px; margin: 0 auto 44px; }
  .sub { color: var(--text-muted); font-size: 17px; line-height: 1.55; }
  .glass {
    background: linear-gradient(160deg, rgba(255,255,255,.04), rgba(255,255,255,.01));
    border: 1px solid var(--border); border-radius: 22px; padding: 26px;
    backdrop-filter: blur(20px); transition: transform .25s ease, border-color .25s ease;
  }
  .glass:hover { transform: translateY(-4px); border-color: rgba(255,255,255,.18); }
  .glass h3 { font-size: 18px; font-weight: 600; margin: 0 0 8px; }
  .glass p { color: var(--text-muted); font-size: 15px; line-height: 1.6; margin: 0; }
  .link { color: var(--accent); font-weight: 600; }

  /* HERO */
  .ext-hero { background: var(--gradient-hero); padding: 72px 0 96px; overflow: hidden; }
  .hero-grid { display: grid; grid-template-columns: 1.05fr 1fr; gap: 56px; align-items: center; }
  .hero-grid > *, .mock-page, .mock-panel, .feat-grid > *, .steps > *, .priv-grid > *, .plans > *, .facts > div > * { min-width: 0; }
  h1, .section-title, .glass h3 { overflow-wrap: anywhere; }
  .crumbs { display: flex; gap: 8px; font-size: 13px; color: var(--text-dim); margin-bottom: 22px; }
  .crumbs a { color: var(--text-muted); }
  h1 { font-size: clamp(38px, 5.6vw, 68px); line-height: 1.02; letter-spacing: -.035em; font-weight: 700; margin: 18px 0 20px; }
  .grad { background: linear-gradient(135deg, var(--accent), var(--accent-2)); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .lead { color: var(--text-muted); font-size: clamp(16px, 1.6vw, 19px); line-height: 1.6; max-width: 560px; }
  .cta-row { display: flex; gap: 14px; flex-wrap: wrap; align-items: center; margin-top: 30px; }
  .center-row { justify-content: center; }
  .btn-chrome {
    display: inline-flex; align-items: center; gap: 10px; padding: 15px 24px; border-radius: 14px;
    background: #fff; color: #0B0E1A; font-weight: 600; font-size: 16px;
    box-shadow: 0 8px 28px rgba(79,209,197,.25); transition: transform .15s ease;
  }
  .btn-chrome:hover { transform: translateY(-2px); color: #0B0E1A; }
  .btn-chrome.is-soon { background: rgba(255,255,255,.08); color: var(--text); border: 1px solid var(--border-strong); box-shadow: none; cursor: default; }
  .btn-chrome.is-soon:hover { transform: none; }
  .btn-ghost { padding: 15px 22px; border-radius: 14px; border: 1px solid rgba(79,209,197,.45); color: var(--accent); font-weight: 600; }
  .btn-ghost:hover { background: rgba(79,209,197,.08); color: var(--accent); }
  .cta-note { color: var(--text-dim); font-size: 13px; margin-top: 12px; }
  .trust { list-style: none; padding: 0; margin: 26px 0 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .trust li { display: inline-flex; align-items: center; gap: 8px; padding: 8px 14px; border-radius: 999px; font-size: 13px; background: rgba(16,185,129,.08); border: 1px solid rgba(16,185,129,.3); }
  .dot, .pill-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--success); box-shadow: 0 0 10px var(--success); display: inline-block; }

  /* MOCK */
  .mock { border-radius: 18px; overflow: hidden; border: 1px solid var(--border-strong); background: #0f1328; box-shadow: 0 40px 80px -30px rgba(0,0,0,.6), 0 0 0 1px rgba(255,255,255,.02); transform: perspective(1400px) rotateY(-6deg); }
  .mock-bar { display: flex; align-items: center; gap: 6px; padding: 10px 14px; background: #161b35; border-bottom: 1px solid var(--border); }
  .mock-bar i { width: 10px; height: 10px; border-radius: 50%; background: rgba(255,255,255,.18); }
  .mock-url { margin-left: 12px; flex: 1; font-size: 11px; color: var(--text-dim); background: rgba(255,255,255,.05); padding: 5px 10px; border-radius: 8px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .mock-body { display: grid; grid-template-columns: 1fr 210px; min-height: 360px; }
  .mock-page { padding: 18px; display: flex; flex-direction: column; gap: 14px; }
  .mock-photo { display: block; width: 100%; height: auto; aspect-ratio: 4/3; object-fit: cover; border-radius: 12px; }
  .mock-lines { display: flex; flex-direction: column; gap: 8px; }
  .mock-lines b { height: 9px; border-radius: 5px; background: rgba(255,255,255,.1); }
  .mock-lines b.short { width: 45%; background: rgba(79,209,197,.35); }
  .mock-thumbs { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; }
  .mock-thumbs img { width: 100%; aspect-ratio: 1; object-fit: cover; transform: scale(1); border-radius: 8px; }
  .mock-panel { border-left: 1px solid var(--border); background: #F5F7FB; color: #1d1d1f; padding: 12px; display: flex; flex-direction: column; gap: 10px; font-size: 11px; }
  .mp-head { display: flex; align-items: center; gap: 6px; font-weight: 700; font-size: 13px; }
  .mp-head img { border-radius: 5px; }
  .mp-tabs { display: flex; gap: 4px; background: #e8e8ee; padding: 3px; border-radius: 8px; }
  .mp-tabs span { flex: 1; text-align: center; padding: 4px 2px; border-radius: 6px; color: #6e6e73; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .mp-tabs .on { background: #fff; color: #1d1d1f; font-weight: 600; }
  .mp-card { background: #fff; border-radius: 10px; padding: 10px; display: flex; flex-direction: column; gap: 2px; border: 1px solid #e5e5ea; }
  .mp-card small { color: #6e6e73; }
  .mp-card em { font-style: normal; font-weight: 700; color: #1f7a4d; margin-top: 4px; }
  .mp-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 5px; }
  .mp-grid span { aspect-ratio: 1; border-radius: 6px; background: #dcdce3; border: 2px solid transparent; }
  .mp-grid .on { border-color: #1f7a4d; background: #cfe3d8; }
  .mp-chip { background: #eef6f1; color: #1f7a4d; border-radius: 999px; padding: 5px 8px; text-align: center; font-weight: 600; }
  .mp-btn { margin-top: auto; background: #1f7a4d; color: #fff; text-align: center; padding: 9px; border-radius: 9px; font-weight: 700; }

  /* REAL SHOTS */
  .mock-panel { padding: 0; background: #f4f4f2; overflow: hidden; }
  .mock-panel img { display: block; width: 100%; height: auto; }
  .mock-body { grid-template-columns: 1fr 230px; height: 440px; min-height: 0; overflow: hidden; }
  .step { display: flex; flex-direction: column; }
  .shot { margin: -10px -10px 18px; border-radius: 16px; overflow: hidden; border: 1px solid var(--border-strong); background: #f4f4f2; height: 420px; box-shadow: 0 20px 40px -20px rgba(0,0,0,.6); }
  .shot img { display: block; width: 100%; height: auto; }

  /* SPEED */
  .speed { padding: 90px 0; background: radial-gradient(ellipse 900px 500px at 50% 30%, rgba(108,140,255,.10), transparent 70%); }
  .stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; margin-bottom: 28px; }
  .stat { text-align: center; padding: 30px 18px; }
  .stat-n { font-size: clamp(40px, 6vw, 64px); font-weight: 700; letter-spacing: -.03em; line-height: 1; background: linear-gradient(135deg, var(--accent), var(--accent-2)); -webkit-background-clip: text; background-clip: text; color: transparent; margin-bottom: 8px; }
  .stat-l { color: var(--text-muted); font-size: 14px; }
  .vs { display: grid; grid-template-columns: 1fr auto 1fr; gap: 18px; align-items: stretch; }
  .vs-arrow { align-self: center; font-size: 30px; color: var(--accent); }
  .vs-col ol { margin: 0; padding-left: 20px; display: flex; flex-direction: column; gap: 10px; color: var(--text-muted); font-size: 15px; line-height: 1.5; }
  .vs-col.manual h3 { color: var(--text-dim); }
  .vs-col.manual ol { text-decoration: line-through; text-decoration-color: rgba(255,255,255,.25); }
  .vs-col.auto { background: linear-gradient(160deg, rgba(79,209,197,.10), rgba(108,140,255,.08)); border-color: rgba(79,209,197,.4); }
  .vs-col.auto ol { color: var(--text); }
  .tree { margin: 28px 0 0; border: 1px solid var(--border); border-radius: 16px; overflow: hidden; background: rgba(0,0,0,.25); }
  .tree figcaption { padding: 10px 16px; font-size: 12px; letter-spacing: .1em; text-transform: uppercase; color: var(--accent); border-bottom: 1px solid var(--border); }
  .tree pre { margin: 0; padding: 16px; font-family: var(--font-mono); font-size: 13px; line-height: 1.7; color: var(--text-muted); overflow-x: auto; }

  /* ANSWER */
  .answer { padding: 0 0 40px; margin-top: -40px; position: relative; }
  .answer-card { border-radius: 24px; padding: 32px; background: linear-gradient(160deg, rgba(79,209,197,.08), rgba(108,140,255,.06)); border: 1px solid rgba(79,209,197,.3); }
  .answer-card h2 { font-size: 14px; text-transform: uppercase; letter-spacing: .14em; color: var(--accent); margin: 0 0 12px; }
  .answer-card > p { font-size: 18px; line-height: 1.65; margin: 0 0 24px; }
  .facts { display: grid; grid-template-columns: 1fr 1fr; gap: 0 28px; margin: 0; }
  .facts div { display: grid; grid-template-columns: 150px 1fr; gap: 12px; padding: 11px 0; border-top: 1px solid var(--border); }
  .facts dt { color: var(--text-dim); font-size: 13px; }
  .facts dd { margin: 0; font-size: 14px; }
  .updated { color: var(--text-dim); font-size: 12px; margin: 18px 0 0; }

  /* HOW */
  .how, .feats, .priv, .pricing, .cmp, .faq { padding: 90px 0; }
  .steps { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .steps .n { display: inline-grid; place-items: center; width: 36px; height: 36px; border-radius: 50%; background: linear-gradient(135deg, var(--accent), var(--accent-2)); color: #0B0E1A; font-weight: 700; margin-bottom: 16px; }

  /* FEATURES */
  .feat-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .works { margin-top: 48px; text-align: center; }
  .works h3 { font-size: 15px; color: var(--text-muted); font-weight: 500; margin: 0 0 16px; }
  .works ul { list-style: none; padding: 0; margin: 0 0 14px; display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; }
  .works li { padding: 9px 16px; border-radius: 999px; border: 1px solid var(--border-strong); font-weight: 600; font-size: 14px; }
  .works p { color: var(--text-dim); font-size: 12px; max-width: 620px; margin: 0 auto; }

  /* PRIVACY */
