---
import type { Lang } from '../i18n/ui';
import { defaultLang } from '../i18n/ui';
import { getExt, CHROME_STORE_URL, CHROME_ICON, EXT_NAV } from '../i18n/extension';

interface Props { lang: Lang; variant: 'home' | 'download' | 'pricing' }
const { lang, variant } = Astro.props;
const c = getExt(lang);
const prefix = lang === defaultLang ? '' : `/${lang}`;
const pageHref = `${prefix}/chrome-extension`;
const feats = c.feats.slice(0, 3);
---

<section class={`ext-callout ext-callout-${variant}`} aria-labelledby={`ext-callout-${variant}`}>
  <div class="ext-callout-in">
    <span class="ext-callout-kicker"><span set:html={CHROME_ICON} />{c.kicker}</span>
    <h2 id={`ext-callout-${variant}`}>{c.h1a}{c.h1b}</h2>
    <p class="ext-callout-lead">{c.lead}</p>

    {variant === 'pricing' ? (
      <ul class="ext-callout-plans">
        {c.plans.map((p) => (
          <li class:list={[{ featured: p.featured }]}>
            <strong>{p.name}</strong>
            <span class="price">{p.price}<small>{p.per}</small></span>
            <span class="note">{p.note}</span>
          </li>
        ))}
      </ul>
    ) : (
      <ul class="ext-callout-feats">
        {feats.map((f) => <li><strong>{f.t}</strong><span>{f.d}</span></li>)}
      </ul>
    )}

    <div class="ext-callout-cta">
      <a class="ext-callout-btn" href={CHROME_STORE_URL} rel="noopener">
        <span set:html={CHROME_ICON} />{c.ctaStore}
      </a>
      <a class="ext-callout-link" href={pageHref}>{EXT_NAV[lang]} →</a>
    </div>
    <p class="ext-callout-note">{c.ctaFree}</p>
  </div>
</section>

<style>
  .ext-callout { padding: 56px 0; }
  .ext-callout-in {
    max-width: 1100px; margin: 0 auto; padding: 32px 28px;
    border: 1px solid var(--line, rgba(128,128,128,0.25)); border-radius: 20px;
    background: var(--card, rgba(128,128,128,0.06));
  }
  .ext-callout-home { padding: 72px 24px; }
  .ext-callout-download, .ext-callout-pricing { padding: 40px 0 8px; }
  .ext-callout-download .ext-callout-in, .ext-callout-pricing .ext-callout-in { max-width: none; }
  .ext-callout-kicker {
    display: inline-flex; align-items: center; gap: 8px; font-size: 12px; font-weight: 700;
    letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent, #4361EE);
  }
  .ext-callout-kicker :global(svg) { width: 18px; height: 18px; }
  h2 { margin: 12px 0 10px; font-size: clamp(1.5rem, 3vw, 2.1rem); line-height: 1.15; color: var(--fg, inherit); }
  .ext-callout-lead { margin: 0 0 22px; max-width: 70ch; color: var(--muted, inherit); line-height: 1.55; }
  .ext-callout-feats, .ext-callout-plans {
    list-style: none; margin: 0 0 24px; padding: 0; display: grid; gap: 14px;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }
  .ext-callout-feats li, .ext-callout-plans li {
    display: flex; flex-direction: column; gap: 6px; padding: 16px;
    border: 1px solid var(--line, rgba(128,128,128,0.25)); border-radius: 14px;
  }
  .ext-callout-feats strong, .ext-callout-plans strong { color: var(--fg, inherit); }
  .ext-callout-feats span, .ext-callout-plans .note { color: var(--muted, inherit); font-size: 0.92rem; line-height: 1.45; }
  .ext-callout-plans .price { font-size: 1.6rem; font-weight: 700; color: var(--fg, inherit); }
  .ext-callout-plans .price small { font-size: 0.85rem; font-weight: 500; color: var(--muted, inherit); margin-inline-start: 2px; }
  .ext-callout-plans li.featured { border-color: var(--accent, #4361EE); }
  .ext-callout-cta { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 22px; }
  .ext-callout-btn {
    display: inline-flex; align-items: center; gap: 10px; padding: 12px 22px; border-radius: 999px;
    background: var(--accent, #4361EE); color: var(--on-accent, #fff); font-weight: 600; text-decoration: none;
  }
  .ext-callout-btn :global(svg) { width: 20px; height: 20px; }
  .ext-callout-btn:hover { filter: brightness(1.08); }
  .ext-callout-link { color: var(--accent, #4361EE); font-weight: 600; text-decoration: none; }
  .ext-callout-link:hover { text-decoration: underline; }
  .ext-callout-note { margin: 14px 0 0; font-size: 0.85rem; color: var(--dim, var(--muted, inherit)); }
</style>
