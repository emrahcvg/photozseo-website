---
import Layout from '../../layouts/Layout.astro';
import HomePage from '../../components/HomePage.astro';
import { languages, defaultLang, type Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return Object.keys(languages)
    .filter((lang) => lang !== defaultLang)
    .map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const title = 'photoZseo — Product Photos & SEO for 46+ Marketplaces';
const description = 'Turn one iPhone photo into 46+ marketplace-ready listings. AI auto-fills SEO, exports to Amazon, Shopify, Etsy, Trendyol & more. B2B quote builder. 3-day free trial.';
---

<Layout title={title} description={description} lang={lang} fullBleed={true}>
  <HomePage lang={lang} />
</Layout>
