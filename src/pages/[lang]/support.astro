---
import Layout from '../../layouts/Layout.astro';
import { languages, defaultLang, type Lang, useTranslations } from '../../i18n/ui';
import '../../styles/legal.css';

export function getStaticPaths() {
  return Object.keys(languages)
    .filter((l) => l !== defaultLang)
    .map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
---

<Layout title={t('support.title')} lang={lang}>
  <article class="legal">
    <a href={`/${lang}/`} class="legal-back">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
      <span>Home</span>
    </a>

    <header class="legal-head">
      <span class="kicker">Support</span>
      <h1>{t('support.title')}</h1>
      <p class="lede">{t('support.intro')}</p>
    </header>

    <h2>{t('support.contact.title')}</h2>
    <p>{t('support.contact.email')} <a href="mailto:support@photozseo.com">support@photozseo.com</a></p>
    <p>{t('support.contact.response')}</p>

    <h2>{t('support.faq.title')}</h2>
    <h3>{t('support.faq.upgrade.q')}</h3>
    <p>{t('support.faq.upgrade.a')}</p>
    <h3>{t('support.faq.restore.q')}</h3>
    <p>{t('support.faq.restore.a')}</p>
    <h3>{t('support.faq.cancel.q')}</h3>
    <p>{t('support.faq.cancel.a')}</p>
    <h3>{t('support.faq.privacy.q')}</h3>
    <p>{t('support.faq.privacy.a')}</p>
    <h3>{t('support.faq.platforms.q')}</h3>
    <p>{t('support.faq.platforms.a')}</p>
    <h3>{t('support.faq.bug.q')}</h3>
    <p>{t('support.faq.bug.a')}</p>
  </article>
</Layout>
