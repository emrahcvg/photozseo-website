---
import Layout from '../layouts/Layout.astro';
import { defaultLang, useTranslations } from '../i18n/ui';
import '../styles/legal.css';

const lang = defaultLang;
const t = useTranslations(lang);
---

<Layout title={t('delete.title')} lang={lang}>
  <article class="legal">
    <a href="/" class="legal-back">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
      <span>Home</span>
    </a>

    <header class="legal-head">
      <span class="kicker">Delete account</span>
      <h1>{t('delete.title')}</h1>
      <p class="lede">{t('delete.intro')}</p>
    </header>

    <h2>{t('delete.app.title')}</h2>
    <ol>
      <li>{t('delete.app.s1')}</li>
      <li>{t('delete.app.s2')}</li>
      <li>{t('delete.app.s3')}</li>
      <li>{t('delete.app.s4')}</li>
      <li>{t('delete.app.s5')}</li>
    </ol>
    <p>{t('delete.app.note')}</p>

    <h2>{t('delete.email.title')}</h2>
    <p>{t('delete.email.desc')}</p>
    <p>{t('delete.email.response')}</p>

    <h2>{t('delete.what.title')}</h2>
    <ul>
      <li>{t('delete.what.f1')}</li>
      <li>{t('delete.what.f2')}</li>
      <li>{t('delete.what.f3')}</li>
    </ul>

    <h2>{t('delete.notaffected.title')}</h2>
    <ul>
      <li>{t('delete.notaffected.f1')}</li>
      <li>{t('delete.notaffected.f2')}</li>
    </ul>

    <blockquote>{t('delete.warning')}</blockquote>
  </article>
</Layout>
