---
import { render } from 'astro:content';
import BlogPost from '../../components/BlogPost.astro';
import { blogEntries } from '../../lib/blog';

export async function getStaticPaths() {
  const { items, langsBySlug } = await blogEntries();
  return items.filter((i) => i.lang === 'en').map((i) => ({
    params: { slug: i.slug },
    props: { entry: i.entry, slug: i.slug, altLangs: langsBySlug.get(i.slug) ?? ['en'] },
  }));
}

const { entry, slug, altLangs } = Astro.props;
const { Content } = await render(entry);
---

<BlogPost data={entry.data} Content={Content} slug={slug} lang="en" altLangs={altLangs} />
