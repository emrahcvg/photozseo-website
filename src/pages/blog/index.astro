---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { defaultLang, useTranslations } from '../../i18n/ui';

const lang = defaultLang;
const t = useTranslations(lang);

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const title = t('blog.title');
---

<Layout title={title} lang={lang}>
  <section class="blog-hero" data-reveal>
    <span class="kicker">{t('blog.kicker')}</span>
    <h1>{t('blog.title')}</h1>
    <p class="blog-sub">{t('blog.sub')}</p>
  </section>

  <ul class="blog-list">
    {posts.map((post, i) => (
      <li class="blog-card" data-reveal style={`transition-delay: ${i * 60}ms`}>
        <a href={`/blog/${post.id}`}>
          <div class="blog-meta">
            <time datetime={post.data.pubDate.toISOString()}>
              {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
            </time>
            <span>·</span>
            <span>{post.data.readingMinutes} min read</span>
          </div>
          <h2>{post.data.title}</h2>
          <p class="blog-card-desc">{post.data.description}</p>
          <div class="blog-tags">
            {post.data.tags.map((tag) => <span class="blog-tag">{tag}</span>)}
          </div>
          <span class="blog-arrow" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </span>
        </a>
      </li>
    ))}
  </ul>

  <style>
    .blog-hero {
      max-width: 760px; margin: 0 auto 56px;
      text-align: center; padding: 32px 24px 8px;
    }
    .kicker {
      display: inline-block; font-size: 12px; font-weight: 700;
      letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent);
      padding: 7px 12px; border-radius: 999px;
      background: rgba(79,209,197,0.10); border: 1px solid rgba(79,209,197,0.28);
      margin-bottom: 18px;
    }
    .blog-hero h1 {
      font-size: clamp(34px, 5vw, 56px); line-height: 1.05;
      letter-spacing: -0.025em; font-weight: 600;
      margin-bottom: 18px; color: var(--text);
    }
    .blog-sub {
      color: var(--text-muted); font-size: clamp(16px, 1.8vw, 19px);
      max-width: 560px; margin: 0 auto; line-height: 1.55;
    }

    .blog-list {
      list-style: none; padding: 0;
      display: grid; gap: 16px;
      max-width: 820px; margin: 0 auto 80px;
    }
    .blog-card a {
      display: grid;
      grid-template-columns: 1fr auto;
      grid-template-areas:
        "meta arrow"
        "title arrow"
        "desc arrow"
        "tags arrow";
      gap: 8px 24px;
      align-items: start;
      background: linear-gradient(160deg, rgba(255,255,255,0.04), rgba(255,255,255,0.01));
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 28px 32px;
      text-decoration: none;
      color: inherit;
      transition: border-color .2s ease, transform .2s ease, background .2s ease;
      backdrop-filter: blur(12px);
    }
    .blog-card a:hover {
      border-color: rgba(79,209,197,0.40);
      background: linear-gradient(160deg, rgba(79,209,197,0.06), rgba(255,255,255,0.01));
      transform: translateY(-2px);
    }
    .blog-card a:hover .blog-arrow {
      color: var(--accent); transform: translateX(4px);
    }

    .blog-meta {
      grid-area: meta;
      display: flex; gap: 8px;
      font-family: var(--font-mono, 'SF Mono', ui-monospace, Menlo, monospace);
      font-size: 12px; color: var(--text-dim);
      letter-spacing: 0.04em;
    }
    .blog-card h2 {
      grid-area: title;
      font-size: clamp(20px, 2.2vw, 26px); font-weight: 600;
      color: var(--text); line-height: 1.25;
      letter-spacing: -0.015em;
      margin: 4px 0 0;
    }
    .blog-card-desc {
      grid-area: desc;
      font-size: 15px; color: var(--text-muted);
      line-height: 1.55; margin: 0;
    }
    .blog-tags {
      grid-area: tags;
      display: flex; flex-wrap: wrap; gap: 6px;
      margin-top: 6px;
    }
    .blog-tag {
      font-size: 11px; font-weight: 600;
      color: var(--text-muted); letter-spacing: 0.04em;
      background: rgba(255,255,255,0.05);
      border: 1px solid var(--border);
      padding: 4px 10px; border-radius: 999px;
    }
    .blog-arrow {
      grid-area: arrow;
      display: flex; align-items: center; justify-content: center;
      width: 36px; height: 36px; border-radius: 50%;
      color: var(--text-dim);
      background: rgba(255,255,255,0.04);
      border: 1px solid var(--border);
      align-self: center;
      transition: color .2s ease, transform .2s ease;
    }

    @media (max-width: 640px) {
      .blog-card a { padding: 22px 22px; gap: 8px 16px; }
      .blog-card h2 { font-size: 19px; }
      .blog-arrow { width: 32px; height: 32px; }
    }
  </style>
</Layout>
